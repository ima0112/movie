  "mediaTypeMovieSingular": "Movie",
  "@mediaTypeMovieSingular": {
    "description": "A single item's own type, e.g. \"2019 · Movie\" in a search result row."
  },
  "mediaTypeTvShowSingular": "TV Show",
  "@mediaTypeTvShowSingular": {
    "description": "A single item's own type, e.g. \"2022 · TV Show\" in a search result row."
  },
  "mediaTypeMoviePlural": "Movies",
  "@mediaTypeMoviePlural": {
    "description": "A segment/filter/tab label covering every movie, e.g. the Movies segmented control option."
  },
  "mediaTypeTvShowPlural": "TV Shows",
  "@mediaTypeTvShowPlural": {
    "description": "A segment/filter/tab label covering every TV show, e.g. the TV Shows segmented control option."
  },
  "mediaTypeTvTag": "TV",
  "@mediaTypeTvTag": {
    "description": "The small corner tag on a TV show's own poster card, distinguishing it from a movie poster at a glance."
  },

  "mediaSegmentAll": "All",
  "@mediaSegmentAll": {
    "description": "MediaSegment.all / FilmographySegment.all — the \"everything, no type filter\" option in a segmented control."
  },

  "personFilmographyAsDirector": "As director",
  "@personFilmographyAsDirector": {
    "description": "D3's filmography segmented control — FilmographySegment.asDirector, only shown once a person has both a cast and a crew credit."
  },

