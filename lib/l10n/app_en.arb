{
  "@@locale": "en",

  "discoverSeeAll": "See all",
  "@discoverSeeAll": {
    "description": "Discover (B1) — link under a carousel section header that opens the full collection as a filtered list (C1)."
  },

  "settingsAboutVersion": "Version {version} ({build})",
  "@settingsAboutVersion": {
    "description": "Settings (C6) → About's Version row value. {version} is the app's own semantic version (e.g. 1.0.0); {build} is the platform build number.",
    "placeholders": {
      "version": {
        "type": "String",
        "example": "1.0.0"
      },
      "build": {
        "type": "String",
        "example": "1"
      }
    }
  },

  "settingsDataDeleteItemCount": "{count, plural, =1{1 item} other{{count} items}}",
  "@settingsDataDeleteItemCount": {
    "description": "Settings (C6) → I1 (Confirm deletion) — how many items a deletion removes (e.g. \"Delete My List\"). {count} is the number of items.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },

  "failureNetwork": "No connection — check your internet and try again.",
  "@failureNetwork": {
    "description": "Failure.localizedMessage (FailureReason.network) — the one translation site every network-shaped error goes through, CLAUDE.md rule 15."
  },
  "failureServer": "TMDB is having trouble right now. Try again in a moment.",
  "@failureServer": {
    "description": "Failure.localizedMessage (FailureReason.server)."
  },
  "failureNotFound": "We couldn't find that.",
  "@failureNotFound": {
    "description": "Failure.localizedMessage (FailureReason.notFound)."
  },
  "failureQuota": "Too many requests — try again in a moment.",
  "@failureQuota": {
    "description": "Failure.localizedMessage (FailureReason.quota)."
  },
  "failureStorage": "Something went wrong saving that on your device.",
  "@failureStorage": {
    "description": "Failure.localizedMessage (FailureReason.storage) — a local drift/SQLite read or write failure, not network-shaped."
  },
  "failureUnknown": "Something went wrong. Try again.",
  "@failureUnknown": {
    "description": "Failure.localizedMessage (FailureReason.unknown) — the generic catch-all."
  },

