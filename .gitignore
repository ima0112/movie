# l10n.yaml's own untranslated-messages-file — a build-time report,
# regenerated on every `flutter gen-l10n` run, not source data.
lib/l10n/untranslated_messages.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local secrets
env/*.json
!env/*.example.json
