<?xml version="1.0" encoding="utf-8"?>
<!-- The app's data (the database with My List, tastes and the onboarding flag)
     stays on the device it was made on: a reinstall, or a new phone, starts
     from the onboarding. Android 12+ reads this; older versions read
     android:allowBackup="false" in the manifest. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
